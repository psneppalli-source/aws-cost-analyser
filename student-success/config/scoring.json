{
  "version": "1.0.0",
  "status": "approved",
  "description": "Initial demonstration configuration. All thresholds are ASSUMPTIONS for demonstration and must be validated by the college before operational use.",
  "coverage_threshold": 0.8,
  "components": {
    "academic": {"label": "Academic", "weight": 0.30},
    "attendance": {"label": "Attendance", "weight": 0.20},
    "lms": {"label": "LMS", "weight": 0.15},
    "placement": {"label": "Placement readiness", "weight": 0.15},
    "skills": {"label": "Skills", "weight": 0.10},
    "engagement": {"label": "Engagement", "weight": 0.10}
  },
  "cohort_profiles": {
    "early_years": {
      "label": "Years 1-2 (placement not yet applicable)",
      "applies_to_years": [1, 2],
      "components": ["academic", "attendance", "lms", "skills", "engagement"]
    },
    "placement_years": {
      "label": "Years 3-4 (all components)",
      "applies_to_years": [3, 4],
      "components": ["academic", "attendance", "lms", "placement", "skills", "engagement"]
    }
  },
  "normalisation": {
    "academic": {
      "indicators": {
        "cgpa": {"weight": 0.5, "worst": 5.0, "best": 9.0},
        "backlogs": {"weight": 0.2, "worst": 4, "best": 0},
        "marks_pct": {"weight": 0.3, "worst": 35, "best": 85}
      }
    },
    "attendance": {"indicators": {"attendance_pct": {"weight": 1.0, "worst": 60, "best": 95}}},
    "lms": {
      "indicators": {
        "assignment_completion_pct": {"weight": 0.6, "worst": 40, "best": 100},
        "logins_per_week": {"weight": 0.4, "worst": 1, "best": 7}
      }
    },
    "placement": {
      "indicators": {
        "aptitude": {"weight": 0.35, "worst": 30, "best": 85},
        "coding": {"weight": 0.4, "worst": 20, "best": 80},
        "mock_interview": {"weight": 0.25, "worst": 1.5, "best": 4.5}
      }
    },
    "skills": {
      "indicators": {
        "technical": {"weight": 0.6, "worst": 30, "best": 90},
        "communication": {"weight": 0.4, "worst": 30, "best": 90}
      }
    },
    "engagement": {
      "indicators": {
        "events": {"weight": 0.3, "worst": 0, "best": 4},
        "clubs": {"weight": 0.2, "worst": 0, "best": 2},
        "projects": {"weight": 0.25, "worst": 0, "best": 2},
        "certifications": {"weight": 0.25, "worst": 0, "best": 2}
      }
    }
  },
  "windows": {
    "assessment_lookback_periods": 6,
    "engagement_lookback_periods": 6,
    "trend_periods": 3
  },
  "bands": [
    {"min": 75, "label": "Strong"},
    {"min": 60, "label": "On track"},
    {"min": 45, "label": "Needs attention"},
    {"min": 0, "label": "At risk"}
  ],
  "risk": {
    "assumption_notice": "Demonstration thresholds. Validate with the college before relying on them.",
    "academic": {
      "required": ["cgpa", "attendance_pct"],
      "rules": [
        {"id": "A1", "indicator": "cgpa", "op": "<", "value": 6.0, "level": "high", "label": "CGPA below 6.0", "intervention": "academic_support_plan"},
        {"id": "A2", "indicator": "cgpa", "op": "<", "value": 6.5, "level": "medium", "label": "CGPA below 6.5", "intervention": "academic_support_plan"},
        {"id": "A3", "indicator": "backlogs", "op": ">=", "value": 2, "level": "high", "label": "Two or more active backlogs", "intervention": "backlog_clearance"},
        {"id": "A4", "indicator": "backlogs", "op": ">=", "value": 1, "level": "medium", "label": "An active backlog", "intervention": "backlog_clearance"},
        {"id": "A5", "indicator": "attendance_pct", "op": "<", "value": 65, "level": "high", "label": "Attendance below 65%", "intervention": "attendance_recovery"},
        {"id": "A6", "indicator": "attendance_pct", "op": "<", "value": 75, "level": "medium", "label": "Attendance below the 75% eligibility rule", "intervention": "attendance_recovery"},
        {"id": "A7", "indicator": "attendance_change", "op": "<=", "value": -10, "level": "medium", "label": "Attendance fell 10+ points over 3 periods", "intervention": "mentor_checkin"},
        {"id": "A8", "indicator": "marks_pct", "op": "<", "value": 40, "level": "high", "label": "Average marks below 40%", "intervention": "subject_tutoring"},
        {"id": "A9", "indicator": "marks_pct", "op": "<", "value": 50, "level": "medium", "label": "Average marks below 50%", "intervention": "subject_tutoring"},
        {"id": "A10", "indicator": "assignment_completion_pct", "op": "<", "value": 50, "level": "medium", "label": "Fewer than half of assignments submitted", "intervention": "assignment_plan"}
      ]
    },
    "placement": {
      "applies_to_profiles": ["placement_years"],
      "required_any": ["aptitude", "coding"],
      "rules": [
        {"id": "P1", "indicator": "coding", "op": "<", "value": 40, "level": "high", "label": "Coding score below 40", "intervention": "coding_bootcamp"},
        {"id": "P2", "indicator": "coding", "op": "<", "value": 55, "level": "medium", "label": "Coding score below 55", "intervention": "coding_bootcamp"},
        {"id": "P3", "indicator": "aptitude", "op": "<", "value": 35, "level": "high", "label": "Aptitude score below 35", "intervention": "aptitude_training"},
        {"id": "P4", "indicator": "aptitude", "op": "<", "value": 50, "level": "medium", "label": "Aptitude score below 50", "intervention": "aptitude_training"},
        {"id": "P5", "indicator": "mock_interview", "op": "<", "value": 2.5, "level": "medium", "label": "Mock interview below 2.5/5", "intervention": "mock_interviews"},
        {"id": "P6", "indicator": "backlogs", "op": ">=", "value": 1, "level": "medium", "label": "Active backlog (most recruiters require none)", "intervention": "backlog_clearance"},
        {"id": "P7", "indicator": "communication", "op": "<", "value": 45, "level": "medium", "label": "Communication assessment below 45", "intervention": "communication_workshop"}
      ]
    }
  },
  "interventions": {
    "academic_support_plan": {"title": "Academic support plan", "category": "academic", "owner_role": "mentor"},
    "backlog_clearance": {"title": "Backlog clearance plan", "category": "academic", "owner_role": "mentor"},
    "attendance_recovery": {"title": "Attendance recovery plan", "category": "attendance", "owner_role": "mentor"},
    "mentor_checkin": {"title": "Mentor check-in on falling attendance", "category": "wellbeing", "owner_role": "mentor"},
    "subject_tutoring": {"title": "Subject tutoring", "category": "academic", "owner_role": "mentor"},
    "assignment_plan": {"title": "Assignment submission plan", "category": "academic", "owner_role": "mentor"},
    "coding_bootcamp": {"title": "Coding bootcamp", "category": "placement_training", "owner_role": "placement_officer"},
    "aptitude_training": {"title": "Aptitude training batch", "category": "placement_training", "owner_role": "placement_officer"},
    "mock_interviews": {"title": "Mock interview series", "category": "placement_training", "owner_role": "placement_officer"},
    "communication_workshop": {"title": "Communication skills workshop", "category": "placement_training", "owner_role": "placement_officer"},
    "collect_placement_data": {"title": "Schedule placement assessments", "category": "placement_training", "owner_role": "placement_officer"}
  },
  "segments": {
    "strong_academics_low_placement": {"label": "Strong academics, low placement readiness", "academic_min": 70, "placement_max": 50},
    "declining_attendance_results": {"label": "Declining attendance and results", "attendance_drop": 8, "academic_drop": 5},
    "strong_skills_academic_support": {"label": "Strong skills, academic support required", "skills_min": 70},
    "improving_after_intervention": {"label": "Improving after intervention", "score_gain": 5},
    "consistently_performing_well": {"label": "Consistently performing well", "score_min": 75},
    "insufficient_data": {"label": "Insufficient data"}
  },
  "feedback_support_needs": {
    "note": "Feedback never changes the score. It is shown as context so staff can offer support.",
    "stress_at_least": 4,
    "satisfaction_at_most": 2
  }
}
