{
  "version": "1.0.0",
  "description": "Canonical permission policy for the Smart Campus Student Success Platform. The backend enforces this file; docs/role-matrix.md is generated from it. Scopes are resolved from trusted server-side assignments linked to the Cognito user ID, never from browser input.",
  "scopes": {
    "college": "Every student in the datasets the user may see",
    "department": "Students in a department the user is assigned to (HOD assignment)",
    "assigned_subject": "Students in a department/year class for a subject the user teaches; record writes must name that subject",
    "assigned_students": "Students the user mentors",
    "own_record": "The signed-in student's own record only",
    "system": "Platform administration objects; never student records",
    "staff_accounts": "Accounts other than System Administrators; never grants the system_admin role"
  },
  "field_sets": {
    "student_core": [
      "student_id",
      "name",
      "department",
      "year",
      "programme",
      "cohort_profile",
      "dataset"
    ],
    "student_master_all": [
      "student_id",
      "name",
      "department",
      "year",
      "programme",
      "cohort_profile",
      "dataset",
      "email",
      "date_of_birth",
      "mentor_sub",
      "mentor_name",
      "status",
      "version",
      "updated_at",
      "updated_by"
    ],
    "insight_all": [
      "student_id",
