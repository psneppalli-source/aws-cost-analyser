# Copy to .env for local development only. Never commit a real .env file.
# AWS credentials are NEVER read from this file — they come exclusively from
# the standard boto3 credential provider chain (AWS_PROFILE, IAM role,
# SSO, env vars set by your shell/orchestrator, etc.).

# Optional: named profile from ~/.aws/config to use instead of the default chain.
AWS_PROFILE=

# Optional: cross-account read access. Both must be set together to enable.
# The role ARN is fixed at startup — it can NEVER be chosen per-request or
# by model/tool-call input.
ASSUME_ROLE_ARN=
ASSUME_ROLE_EXTERNAL_ID=

# Safety caps (sane defaults are baked in; override only if you understand
# the DoS/cost implications of raising them).
MAX_RESULT_PAGES=10
MAX_RESULTS_PER_PAGE=100
MAX_TIME_RANGE_DAYS=366
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=30
AWS_MAX_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=INFO
